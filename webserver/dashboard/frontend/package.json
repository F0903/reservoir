{
    "name": "reservoir-dashboard",
    "private": true,
    "version": "0.17.0",
    "packageManager": "pnpm@10.23.0",
    "type": "module",
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "browserslist": [
        ">0.5%",
        "last 2 versions",
        "Firefox ESR",
        "not dead"
    ],
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/kit": "^3.1.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.6",
        "@vitest/browser": "^5.1.0",
        "autoprefixer": "^10.6.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "postcss": "^8.5.32",
        "postcss-load-config": "^6.0.1",
        "postcss-preset-env": "^11.6.2",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.7",
        "vite-plugin-devtools-json": "^1.1.2",
        "vitest": "^5.1.0"
    },
    "pnpm": {
        "overrides": {
            "ws": "^8.20.1"
        },
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "dependencies": {
        "@fontsource-variable/chivo-mono": "^5.3.0",
        "@fontsource-variable/open-sans": "^5.3.0",
        "@lucide/svelte": "^1.70.0",
        "@sveltejs/adapter-static": "^4.0.1",
        "chart.js": "^4.6.1"
    }
}
